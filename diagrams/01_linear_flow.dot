	n0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" FIXEDSIZE="TRUE" WIDTH="980" HEIGHT="58"><TR><TD WIDTH="200" FIXEDSIZE="TRUE" HEIGHT="50" ALIGN="LEFT"><B><FONT POINT-SIZE="13">CNC / PLC / Sensors<BR ALIGN="LEFT"/></FONT></B></TD><TD WIDTH="430" FIXEDSIZE="TRUE" HEIGHT="50" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#2a78d6">Fanuc 0i/31i, SINUMERIK 828D/840D sl, spindle accelerometers,<BR ALIGN="LEFT"/>10 streams/machine<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="350" FIXEDSIZE="TRUE" HEIGHT="50" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#52514e" POINT-SIZE="10">Real data: Bosch 2 kHz vibration, UMich 10 Hz spindle;<BR ALIGN="LEFT"/>fleet = Azure PdM backbone<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>> color="#c3c2b7" fillcolor="#f3f2ee" margin=0.05 shape=box style="rounded,filled"]
	n1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" FIXEDSIZE="TRUE" WIDTH="980" HEIGHT="58"><TR><TD WIDTH="200" FIXEDSIZE="TRUE" HEIGHT="50" ALIGN="LEFT"><B><FONT POINT-SIZE="13">OPC UA / MQTT<BR ALIGN="LEFT"/></FONT></B></TD><TD WIDTH="430" FIXEDSIZE="TRUE" HEIGHT="50" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#2a78d6">FASOPC &amp; SINUMERIK OPC UA servers; MQTT 3.1.1/5 with TLS,<BR ALIGN="LEFT"/>Unified Namespace topics<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="350" FIXEDSIZE="TRUE" HEIGHT="50" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#52514e" POINT-SIZE="10">tier1/&lt;site&gt;/&lt;area&gt;/&lt;machine&gt;/... topics (paho-mqtt,<BR ALIGN="LEFT"/>QoS 1)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>> color="#c3c2b7" fillcolor="#f3f2ee" margin=0.05 shape=box style="rounded,filled"]
	n0 -> n1 [color="#2a78d6" penwidth=2]
	n2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" FIXEDSIZE="TRUE" WIDTH="980" HEIGHT="58"><TR><TD WIDTH="200" FIXEDSIZE="TRUE" HEIGHT="50" ALIGN="LEFT"><B><FONT POINT-SIZE="13">Edge Gateway<BR ALIGN="LEFT"/></FONT></B></TD><TD WIDTH="430" FIXEDSIZE="TRUE" HEIGHT="50" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#2a78d6">Azure IoT Operations on Arc-enabled K3s / AKS Edge Essentials:<BR ALIGN="LEFT"/>OPC UA connector, MQTT broker, data flows; durable outbox<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="350" FIXEDSIZE="TRUE" HEIGHT="50" ALIGN="LEFT" BALIGN="LEFT"><FONT COLOR="#52514e" POINT-SIZE="10">python/edge: 1-s features (143x reduction), SQLite<BR ALIGN="LEFT"/>store-and-forward, 0 lost<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>> color="#c3c2b7" fillcolor="#e6f0fb" margin=0.05 shape=box style="rounded,filled"]
	n1 -> n2 [color="#2a78d6" penwidth=2]
